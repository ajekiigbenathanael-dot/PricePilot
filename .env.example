# PricePilot environment variables.
# Copy this file to `.env` and fill in your project's values:
#   cp .env.example .env
#
# `.env` and `.env.*` are gitignored (only this example is tracked) — never
# commit real keys.

# ---- Frontend (Vite) --------------------------------------------------------
# Read by src/lib/supabase.ts and shipped in the browser bundle. Safe to expose:
# Row Level Security governs what the anon (public) key can read/write.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---- Server-side only -------------------------------------------------------
# NEVER prefix with VITE_ and never ship to the browser. Used only by
# scripts/ingest-jumia.mjs to write products + price_observations with elevated
# privileges (RLS blocks anon/authenticated writes).
#
# NOTE: the `check-price` Edge Function does NOT read this from here — Supabase
# auto-injects SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY into deployed functions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Optional: only set this if the ingest should target a different project than
# the frontend. Left unset, the ingest reuses VITE_SUPABASE_URL above.
# SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# ---- Scraper ----------------------------------------------------------------
# Reachable contact embedded in the scraper's honest User-Agent. Jumia's crawler
# policy requires a reachable owner for automated crawling. Not a secret, but it
# IS sent to every site we scrape, so set a real email or URL. Overrides the
# committed fallback in scripts/scrape-jumia.mjs; for the scheduled cron, set the
# same value as a GitHub Actions repo secret (see DEPLOYMENT.md).
# SCRAPER_CONTACT=you@example.com
