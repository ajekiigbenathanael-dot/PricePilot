# PricePilot environment variables.
# Copy this file to `.env` and fill in your values:
#   cp .env.example .env
#
# `.env` and `.env.*` are gitignored (only this example is tracked) — never
# commit real credentials.

# ---- Server-side only (database) --------------------------------------------
# NEVER prefix with VITE_ and never ship to the browser. Read by the `/api`
# serverless functions (api/_lib/db.ts) and the ingest scripts (scripts/db.mjs)
# to read/write products + price_observations. The browser NEVER connects to
# MongoDB directly — it only calls the same-origin `/api`.
#
# Use a MongoDB Atlas connection string (mongodb+srv://…), or mongodb://localhost:27017
# for a local database. In production set MONGODB_URI as a Vercel env var (Project
# Settings → Environment Variables) — NOT a VITE_ var — and as a GitHub Actions
# repo secret for the scheduled ingest.
MONGODB_URI=mongodb://localhost:27017

# Optional: database name (defaults to "pricepilot" when unset).
# MONGODB_DB=pricepilot

# ---- Frontend (Vite) --------------------------------------------------------
# The browser talks to its own backend at same-origin `/api` by default, so no
# frontend env var is required. Set this ONLY to point the browser at a different
# API origin (rare). It is shipped in the client bundle, so it must never contain
# a secret — an origin URL only.
# VITE_API_BASE_URL=https://api.example.com

# ---- Scraper ----------------------------------------------------------------
# Reachable contact embedded in the scraper's honest User-Agent. Jumia's crawler
# policy requires a reachable owner for automated crawling. Not a secret, but it
# IS sent to every site we scrape, so set a real email or URL. Overrides the
# committed fallback in scripts/scrape-jumia.mjs; for the scheduled cron, set the
# same value as a GitHub Actions repo secret (see DEPLOYMENT.md).
# SCRAPER_CONTACT=you@example.com
